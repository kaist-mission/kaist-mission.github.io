---
// 사진 하나: '~/assets/images/…' 경로는 빌드 시 최적화하고, 외부 주소는 그대로 보여 줍니다.
import { Image } from 'astro:assets';
import { findImage } from '~/utils/images';

export interface Props {
  src: string;
  alt?: string;
  sizes?: string;
  class?: string;
  position?: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt = '', sizes = '100vw', class: className, position, loading = 'lazy' } = Astro.props;
const image = await findImage(src);
const style = position ? { objectPosition: position } : undefined;
---

{
  typeof image === 'string' ? (
    <img src={image} alt={alt} loading={loading} class={className} style={style} />
  ) : image ? (
    <Image
      src={image}
      alt={alt}
      widths={[480, 800, 1200, 1600]}
      sizes={sizes}
      loading={loading}
      class={className}
      style={style}
    />
  ) : null
}
