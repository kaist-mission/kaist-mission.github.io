---
// 모든 페이지 공통 목록. 항목은 문자열 또는 { label, text } (label은 굵게 표시)
export type BulletItem = string | { label: string; text: string };

export interface Props {
  items: BulletItem[];
}

const { items } = Astro.props;
---

<ul class="list-disc pl-5 space-y-1.5 marker:text-gray-400">
  {
    items.map((item) =>
      typeof item === 'string' ? (
        <li class="pl-1">{item}</li>
      ) : (
        <li class="pl-1">
          <strong class="font-semibold">{item.label}:</strong> {item.text}
        </li>
      )
    )
  }
</ul>
