---
// 메인 페이지 상단: 배경 사진 + 반투명 막 + 가운데 제목/설명/버튼
import Picture from '~/components/site/Picture.astro';

export interface Props {
  /** '~/assets/images/…' 경로 */
  image: string;
  /** 사진에서 보여 줄 위치 (CSS object-position) */
  position?: string;
}

const { image, position = 'center' } = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <Picture
    src={image}
    position={position}
    loading="eager"
    class="absolute inset-0 -z-10 w-full h-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-black/45" aria-hidden="true"></div>
  <div class="max-w-5xl mx-auto px-4 md:px-6 py-28 md:py-40 text-center [text-shadow:0_1px_14px_rgb(0_0_0/0.35)]">
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight leading-[1.2] text-white">
      <slot name="title" />
    </h1>
    {
      Astro.slots.has('subtitle') && (
        <p class="mt-6 md:mt-8 max-w-2xl mx-auto text-lg md:text-xl leading-relaxed text-white/90">
          <slot name="subtitle" />
        </p>
      )
    }
    {
      Astro.slots.has('actions') && (
        <div class="mt-10 [text-shadow:none]">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
