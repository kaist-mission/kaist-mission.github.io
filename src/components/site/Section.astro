---
// 모든 페이지 공통 영역: 제목 + 내용
export interface Props {
  id?: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="scroll-mt-[72px] max-w-5xl mx-auto px-4 md:px-6">
  <div class="py-7 md:py-9">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-heading mb-4 md:mb-5">{title}</h2>
    <div class="text-lg leading-relaxed text-heading text-justify">
      <slot />
    </div>
  </div>
</section>
