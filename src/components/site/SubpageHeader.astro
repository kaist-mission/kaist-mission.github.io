---
// 하위 페이지 공통 머리: 왼쪽 정렬 제목 + 설명 + 가로로 긴 사진
import Picture from '~/components/site/Picture.astro';

export interface Props {
  title: string;
  /** '~/assets/images/…' 경로 */
  image?: string;
  imageAlt?: string;
  /** 사진에서 보여 줄 위치 (CSS object-position) */
  position?: string;
}

const { title, image, imageAlt = '', position = 'center' } = Astro.props;
---

<section class="max-w-5xl mx-auto px-4 md:px-6 pt-16 md:pt-24 pb-4">
  <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight leading-[1.2] text-heading">{title}</h1>
  {
    Astro.slots.has('default') && (
      <p class="mt-6 text-lg md:text-xl leading-relaxed text-muted text-justify">
        <slot />
      </p>
    )
  }
  {
    image && (
      <Picture
        src={image}
        alt={imageAlt}
        position={position}
        sizes="(max-width: 1024px) 100vw, 1024px"
        loading="eager"
        class="mt-10 md:mt-14 w-full h-56 sm:h-72 md:h-80 object-cover rounded-md"
      />
    )
  }
</section>
