---
// 카카오맵 (키 없이 iframe으로 표시)
export interface Props {
  address: string;
}

const { address } = Astro.props;
---

<iframe
  src={`https://map.kakao.com/?q=${encodeURIComponent(address)}`}
  title={`${address} 지도`}
  loading="lazy"
  class="block w-full h-80 md:h-[28rem] rounded-md border border-gray-200 bg-gray-100"></iframe>
